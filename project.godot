; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="babamech"
config/description="Co-op chicken-legged mech combat inside a rotating ring habitat (scaffold)"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7")
run/flush_stdout_on_print=true

[autoload]

Session="*res://scripts/net/net_session.gd"
Audio="*res://scripts/audio/audio_director.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
; First-run shader stalls: keep compiled shaders (RD and GL) and Vulkan pipelines on disk between runs. Both are Godot's
; defaults, pinned on purpose (the second launch / second mission must stay stall-free); the FIRST run is covered by
; ShaderWarmup (scripts/mission/shader_warmup.gd). Godot 4.7 has no switch for Forward+'s ubershaders (always on).
shader_compiler/shader_cache/enabled=true
rendering_device/pipeline_cache/enable=true
