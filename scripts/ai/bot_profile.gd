static func get_profile(id: String) -> Dictionary:
	return (PROFILES.get(id, PROFILES["average"]) as Dictionary).duplicate(true)


static func has_profile(id: String) -> bool:
	return PROFILES.has(id)


static func get_loadout(name_or_profile: String) -> Dictionary:
	if LOADOUTS.has(name_or_profile):
		return (LOADOUTS[name_or_profile] as Dictionary).duplicate()
	if PROFILES.has(name_or_profile):
		var lid := str((PROFILES[name_or_profile] as Dictionary).get("loadout", "default"))
		return (LOADOUTS.get(lid, LOADOUTS["default"]) as Dictionary).duplicate()
	return (LOADOUTS["default"] as Dictionary).duplicate()
